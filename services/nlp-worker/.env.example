WORKER_PORT=8001
LOG_LEVEL=info

# Provider de LLM agnostico — ver ADR 0004.
# Default: OpenAI direto com gpt-4o-mini.
#
# === Como obter API key por provider ===
#
# OpenAI (default no MVP):
#   - Cadastro: https://platform.openai.com/signup
#   - Gerar key: https://platform.openai.com/api-keys
#   - Billing (precisa cartao): https://platform.openai.com/account/billing
#   - Modelos: https://platform.openai.com/docs/models
#
# Azure OpenAI (Enterprise):
#   - Solicitar acesso: https://aka.ms/oai/access
#   - Portal: https://portal.azure.com/ (criar recurso "Azure OpenAI")
#   - Docs: https://learn.microsoft.com/azure/ai-services/openai/
#   - LLM_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>
#
# Groq (gratis e rapido, otimo pra dev):
#   - Cadastro: https://console.groq.com/login
#   - API keys: https://console.groq.com/keys
#   - LLM_BASE_URL=https://api.groq.com/openai/v1
#   - Ex.: LLM_MODEL=llama-3.3-70b-versatile
#
# OpenRouter (varios modelos via uma key):
#   - Cadastro: https://openrouter.ai/sign-up
#   - API keys: https://openrouter.ai/keys
#   - LLM_BASE_URL=https://openrouter.ai/api/v1
#
# Ollama (local, sem custo):
#   - Download: https://ollama.com/download
#   - LLM_BASE_URL=http://localhost:11434/v1
#   - LLM_API_KEY=ollama (qualquer string)
#   - LLM_MODEL=llama3.1
#
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Quando true ou vazio, o worker usa stub local sem custo de API.
USE_LLM_STUB=true
