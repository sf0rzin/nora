WORKER_PORT=8001
LOG_LEVEL=info

# Provider de LLM agnóstico — ver ADR 0004.
# Default: OpenAI direto com gpt-4o-mini.
# Para Azure OpenAI, troque base_url, model (deployment) e api_key.
# Para Groq/OpenRouter/Ollama, ajuste base_url e model.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Quando true ou vazio, o worker usa stub local sem custo de API.
USE_LLM_STUB=true
