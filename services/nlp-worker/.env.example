# Configuração local do NLP worker (FastAPI). Copie para .env.local.
WORKER_PORT=8001
LOG_LEVEL=info

LLM_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_CHAT=gpt-4o
AZURE_OPENAI_DEPLOYMENT_EMBEDDING=text-embedding-3-large
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Quando vazio, o worker usa um stub local que devolve fixtures determinísticas
# para permitir desenvolvimento sem custo de API.
USE_LLM_STUB=true
