WORKER_PORT=8001
LOG_LEVEL=info

# --- Internal service-to-service auth (ADR 0023 §3-4) ------------------------
# The API sends this value in the `X-Internal-Token` header on every call to /analyze,
# /split and /analyze-live. Without it, anything that can reach this port posts a
# transcript and spends an LLM call on the project's account.
#
# This is NOT the same secret as NORA_PLATFORM_INTERNAL_TOKEN, which goes the other way
# (worker/BFF -> API's /internal/platform/**). Two directions, two values.
#
#   set          -> the header is required and compared in constant time; 401 on mismatch
#   empty        -> /analyze, /split and /analyze-live answer 503, on purpose (fail-closed)
#   empty + the opt-out below = true -> open, with a WARN per request. Local dev only.
#
# `make env` copies this file to .env.local, so the values below are what `make dev` runs
# with: the opt-out ships as true so a fresh clone works, and the token ships empty.
# Generate one with: openssl rand -hex 32
NORA_WORKER_INTERNAL_TOKEN=
NORA_WORKER_ALLOW_UNAUTHENTICATED=true

# --- PII Shield: the second layer has no variable, and that is the point ------
# Every transcript goes through `services/pii_shield.py` before any external call. Behind the
# deterministic rules sits a statistical backstop for person names (`services/pii_ner.py`),
# spaCy running the `pt_core_news_sm` pt-BR pipeline. Measured over the 5,664-case corpus:
#
#   deterministic only   leak 120/5664 (2.12%)   false redaction 512/5507 ( 9.30%)
#   with the backstop    leak  23/5664 (0.41%)   false redaction 609/5507 (11.06%)
#
# This block exists so nobody goes hunting for the flag that turns it on. There is none. What
# decides is whether the model is installed:
#
#   pip install -r requirements-ner.txt
#
# which is what the Dockerfile, the `worker` CI job and `make worker-setup` install from. Without
# it the module returns no spans and the deterministic shield behaves exactly as it always did —
# the first row's rates, reached quietly: nothing fails, `/readyz` still says ready, and every
# response is still a 200. The image asserts the model loads at build time for that reason.

# Provider-agnostic LLM — see ADR 0004.
# Default: OpenAI directly with gpt-4o-mini.
#
# === How to get an API key per provider ===
#
# OpenAI (default in the MVP):
#   - Signup: https://platform.openai.com/signup
#   - Generate key: https://platform.openai.com/api-keys
#   - Billing (card required): https://platform.openai.com/account/billing
#   - Models: https://platform.openai.com/docs/models
#
# Azure OpenAI (Enterprise):
#   - Request access: https://aka.ms/oai/access
#   - Portal: https://portal.azure.com/ (create an "Azure OpenAI" resource)
#   - Docs: https://learn.microsoft.com/azure/ai-services/openai/
#   - LLM_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>
#
# Groq (free and fast, great for dev):
#   - Signup: https://console.groq.com/login
#   - API keys: https://console.groq.com/keys
#   - LLM_BASE_URL=https://api.groq.com/openai/v1
#   - E.g.: LLM_MODEL=llama-3.3-70b-versatile
#
# OpenRouter (several models via one key):
#   - Signup: https://openrouter.ai/sign-up
#   - API keys: https://openrouter.ai/keys
#   - LLM_BASE_URL=https://openrouter.ai/api/v1
#
# Ollama (local, no cost):
#   - Download: https://ollama.com/download
#   - LLM_BASE_URL=http://localhost:11434/v1
#   - LLM_API_KEY=ollama (any string)
#   - LLM_MODEL=llama3.1
#
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Wall-clock budget for one request, across every retry and every window of /split.
# It has to stay below the caller's deadline: the API's WebClient gives up at
# `nora.worker.timeout-millis` (120000). Without a budget the worker could spend up to 360s on a
# single call — three SDK attempts, then the whole prompt again in JSON mode — and keep burning
# paid tokens for four minutes after the caller had already walked away. The ~30s of slack pays
# for the PII Shield, the TF-IDF baseline and the HTTP round trip.
LLM_REQUEST_BUDGET_SECONDS=90

# When true or empty, the worker uses a local stub with no API cost.
USE_LLM_STUB=true
