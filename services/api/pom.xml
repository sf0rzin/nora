<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>br.com.nora</groupId>
    <artifactId>nora-api</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>nora-api</name>
    <description>NORA backend API</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spotless.version>3.9.0</spotless.version>
        <checkstyle.version>3.6.0</checkstyle.version>
        <jacoco.version>0.8.15</jacoco.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <springdotenv.version>5.1.0</springdotenv.version>
        <!--
          docker.host: default tcp://localhost:2375 (Docker Desktop with "Expose daemon on tcp"
          enabled). Override via -Ddocker.host=npipe:////./pipe/docker_engine on Windows without
          TCP, or unix:///var/run/docker.sock on Linux/Mac. In CI without Docker Desktop,
          Testcontainers also discovers it via the DOCKER_HOST env var.
        -->
        <docker.host>tcp://localhost:2375</docker.host>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.9.0</version>
        </dependency>

        <!-- JWT (US01-US04 auth) -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.13.0</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.13.0</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.13.0</version>
            <scope>runtime</scope>
        </dependency>

        <!-- HTTP client for the external email provider (Resend) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- Dev convenience: loads .env(.local) automatically at runtime -->
        <dependency>
            <groupId>me.paulschwarz</groupId>
            <artifactId>springboot3-dotenv</artifactId>
            <version>${springdotenv.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- Rate limiting (Auth) -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j-core</artifactId>
            <version>8.10.1</version>
        </dependency>

        <!-- Cache with TTL + maximumSize for bounded eviction (AuthRateLimiter). -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- AOP — Spring uses proxies internally, but AspectJ annotations need the explicit
             starter. Used by TenantRlsAspect (Postgres RLS). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>3.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <googleJavaFormat>
                            <version>1.24.0</version>
                            <style>AOSP</style>
                        </googleJavaFormat>
                        <removeUnusedImports/>
                        <importOrder/>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${checkstyle.version}</version>
                <configuration>
                    <configLocation>checkstyle.xml</configLocation>
                    <consoleOutput>true</consoleOutput>
                    <failsOnError>true</failsOnError>
                    <includeTestSourceDirectory>false</includeTestSourceDirectory>
                </configuration>
                <executions>
                    <execution>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <docker.host>${docker.host}</docker.host>
                        <api.version>1.40</api.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!--
                      Coverage gate on the critical IAM areas (ADR 0018: >85% sustained on
                      IAM/Auth/PII). The first rule is scoped to ONE class — PolicyEvaluator,
                      the IAM authorization decision point (ADR 0007), covered by
                      PolicyEvaluatorTest (~22 unit tests, no Docker). Measured locally:
                      INSTRUCTION 0.945 / BRANCH 0.806 — the limits below (0.90 / 0.75) pass
                      with headroom and are meaningful.

                      The second and third rules exist because one class was the WHOLE gate.
                      A drop in AuthService, AuthorizationService, IamService, the security
                      filters or the persistence adapters passed `mvn verify` in silence, and
                      the 77% figure the documentation quotes was a measurement nobody
                      re-checked. standards.md is honest that it is a report rather than a
                      gate — but "declared as unguarded" and "guarded" are different states,
                      and this moves two of them.

                      The thresholds are floors with deliberate headroom, not targets. Measured
                      2026-08-17 across the whole bundle: 77.1-77.3% instruction and
                      61.5-61.6% branch, over three runs. The BUNDLE rule sits at 0.70 / 0.55,
                      roughly seven and six points below, so ordinary variance between runs
                      never reddens the build while a real regression does. The domain.iam
                      PACKAGE rule sits at 0.80 against a measured ~0.83 for the same reason.
                      Raising either one is a separate decision that needs a fresh measurement
                      in CI with Docker, because Testcontainers is what covers
                      application/identity and infrastructure/security and it does not run
                      locally.

                      RE-CHECKED 2026-08-23, after the audit round added roughly two thousand
                      lines of Java. The measurement above predates that code, so the question
                      was whether the new denominator could push the bundle under its floor. It
                      cannot: the same command on the same machine reports 53,500 total
                      instructions at origin/main and 55,058 here, a growth of 2.9%. Even if
                      every new instruction were uncovered, 77.1% x (53500/55058) = 74.9%, which
                      still clears 0.70 — and the new code arrived with tests. What did NOT
                      reproduce is the absolute: CI reported a total of 41,596 instructions for
                      the same tree where this machine reports 53,500, and neither the plugin
                      config nor report-coverage.sh filters any row, so the difference is
                      unexplained rather than accounted for. The DELTA is what this note rests
                      on, because the delta is what the floor is exposed to.
                    -->
                    <execution>
                        <id>check-iam-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>br.com.nora.api.domain.iam.PolicyEvaluator</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.75</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>br.com.nora.api.domain.iam</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.55</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                            <haltOnFailure>true</haltOnFailure>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
