# Configuracao local do backend (Spring Boot). Copie para .env.local.
# Nunca commite .env.local.

# --- Spring profile / server ---
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# --- spring-dotenv (dev only) ---
# A API carrega automaticamente `services/api/.env.local` via springboot3-dotenv.
# Estas vars sao opcionais e servem apenas para override do comportamento do dotenv.
# SPRINGDOTENV_ENABLED=true
# SPRINGDOTENV_FILENAME=.env.local
# SPRINGDOTENV_DIRECTORY=.
# SPRINGDOTENV_IGNORE_IF_MISSING=true
# SPRINGDOTENV_IGNORE_IF_MALFORMED=false
# SPRINGDOTENV_EXPORT_TO_SYSTEM_PROPERTIES=false

# --- Database (Postgres) ---
DATASOURCE_URL=jdbc:postgresql://localhost:5432/nora
DATASOURCE_USERNAME=nora
DATASOURCE_PASSWORD=nora_dev

# --- Auth / JWT ---
# ATENCAO: em producao, use um secret forte (min 32 chars) e mantenha fora do repo.
# Gere um secret forte (32+ chars) com: `openssl rand -base64 48`
# Ou online: https://generate-secret.vercel.app/32
JWT_SECRET=change-me-please-min-32-chars-long-aaaa
JWT_EXPIRES_SECONDS=3600

# --- Auth flows (tokens one-time) ---
EMAIL_VERIFICATION_EXPIRES_SECONDS=86400
PASSWORD_RESET_EXPIRES_SECONDS=3600

# --- Dev convenience (profile local) ---
# Se true, a API retorna tokens de verificacao/reset no JSON para facilitar testes manuais.
EXPOSE_DEV_TOKENS=false

# --- App URLs ---
NORA_APP_PUBLIC_BASE_URL=http://localhost:3000

# --- E-mail ---
# NORA usa Resend para envio de e-mails (verificacao de conta, reset de senha).
# 1. Crie conta gratuita: https://resend.com/signup (3.000 emails/mes free)
# 2. Gere a API key: https://resend.com/api-keys
# 3. Para producao, configure dominio proprio: https://resend.com/domains
# Em dev, deixe RESEND_API_KEY vazio para usar LogEmailSender (links no log do app).
NORA_EMAIL_FROM=NORA <onboarding@resend.dev>
RESEND_API_KEY=

# --- Integracoes OAuth (NORA Flows Fase 2: Gmail / Google Calendar) ---
# 1. Crie um projeto no Google Cloud Console e configure a OAuth consent screen.
# 2. Crie um OAuth Client ID (tipo Web) com redirect URI apontando para a API:
#    dev:  http://localhost:8080/integrations/google/oauth/callback
#    prod: https://api.nora.systems/integrations/google/oauth/callback
# 3. Habilite as APIs: Gmail API e Google Calendar API.
# Escopos pedidos: openid email, gmail.send, calendar.events.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/integrations/google/oauth/callback
# Assina o state do OAuth (HMAC). Vazio em dev = segredo efemero por boot.
NORA_INTEGRATIONS_STATE_SECRET=
# Cifra tokens OAuth em repouso (AES-256-GCM): 32 bytes em base64.
# Gere com: openssl rand -base64 32 . Vazio em dev = tokens sem cifra (WARN no log).
NORA_INTEGRATIONS_ENC_KEY=

# --- Integracoes OAuth (NORA Flows Fase 2: Slack) ---
# 1. Crie um app em https://api.slack.com/apps (From scratch) na sua workspace.
# 2. Em "OAuth & Permissions" > Bot Token Scopes, adicione: chat:write e channels:read.
# 3. Em "OAuth & Permissions" > Redirect URLs, registre o callback da API:
#    dev:  http://localhost:8080/integrations/slack/oauth/callback
#    prod: https://api.nora.systems/integrations/slack/oauth/callback
# 4. Client ID e Client Secret ficam em "Basic Information" > App Credentials.
# O bot token (xoxb-...) nao expira; para postar num canal, convide o bot: /invite @NORA.
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URI=http://localhost:8080/integrations/slack/oauth/callback

# --- Integracoes OAuth (onda 1: GitHub, Notion, Todoist, Linear) ---
# Todos OAuth2 code-flow padrao, sem refresh token na pratica. Redirect URI a registrar
# em cada provedor: <api>/integrations/<provider>/oauth/callback (dev: localhost:8080).
# GitHub: OAuth App em https://github.com/settings/developers (escopo repo).
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8080/integrations/github/oauth/callback
# Notion: integracao publica em https://www.notion.so/my-integrations (capabilities de
# inserir conteudo). A pagina pai usada nos fluxos precisa ser compartilhada com a integracao.
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=http://localhost:8080/integrations/notion/oauth/callback
# Todoist: app em https://developer.todoist.com/appconsole.html (escopo data:read_write).
TODOIST_OAUTH_CLIENT_ID=
TODOIST_OAUTH_CLIENT_SECRET=
TODOIST_OAUTH_REDIRECT_URI=http://localhost:8080/integrations/todoist/oauth/callback
# Linear: app OAuth em https://linear.app/settings/api/applications (escopo write).
LINEAR_OAUTH_CLIENT_ID=
LINEAR_OAUTH_CLIENT_SECRET=
LINEAR_OAUTH_REDIRECT_URI=http://localhost:8080/integrations/linear/oauth/callback

# --- NLP Worker ---
NLP_WORKER_BASE_URL=http://localhost:8001

# --- Azure Speech (backend broker) ---
# Chave de assinatura do Azure Speech Service. O backend emite tokens JWT efemeros
# para o desktop usar, sem expor a chave real no client.
AZURE_SPEECH_KEY=
# Regiao padrao do Azure Speech (ex: brazilsouth, eastus, westeurope).
# O desktop pode solicitar outra regiao via parametro ?region=.
AZURE_SPEECH_REGION=brazilsouth

# --- Logging ---
LOG_LEVEL=INFO
