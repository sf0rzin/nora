# Local backend configuration (Spring Boot). Copy to .env.local.
# Never commit .env.local.

# --- Spring profile / server ---
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# --- spring-dotenv (dev only) ---
# The API automatically loads `services/api/.env.local` via springboot3-dotenv.
# These vars are optional and only serve to override the dotenv behaviour.
# SPRINGDOTENV_ENABLED=true
# SPRINGDOTENV_FILENAME=.env.local
# SPRINGDOTENV_DIRECTORY=.
# SPRINGDOTENV_IGNORE_IF_MISSING=true
# SPRINGDOTENV_IGNORE_IF_MALFORMED=false
# SPRINGDOTENV_EXPORT_TO_SYSTEM_PROPERTIES=false

# --- Database (Postgres) ---
DATASOURCE_URL=jdbc:postgresql://localhost:5432/nora
DATASOURCE_USERNAME=nora
DATASOURCE_PASSWORD=nora_dev

# --- Auth / JWT ---
# WARNING: in production, use a strong secret (min 32 chars) and keep it out of the repo.
# Generate a strong secret (32+ chars) with: `openssl rand -base64 48`
# Or online: https://generate-secret.vercel.app/32
JWT_SECRET=change-me-please-min-32-chars-long-aaaa
JWT_EXPIRES_SECONDS=3600

# --- Auth flows (one-time tokens) ---
EMAIL_VERIFICATION_EXPIRES_SECONDS=86400
PASSWORD_RESET_EXPIRES_SECONDS=3600

# --- Dev convenience (local profile) ---
# If true, the API returns verification/reset tokens in the JSON to ease manual testing.
EXPOSE_DEV_TOKENS=false

# --- App URLs ---
NORA_APP_PUBLIC_BASE_URL=http://localhost:3000

# --- E-mail ---
# NORA uses Resend to send e-mails (account verification, password reset).
# 1. Create a free account: https://resend.com/signup (3,000 emails/month free)
# 2. Generate the API key: https://resend.com/api-keys
# 3. For production, configure your own domain: https://resend.com/domains
# In dev, leave RESEND_API_KEY empty to use LogEmailSender (links in the app log).
NORA_EMAIL_FROM=NORA <onboarding@resend.dev>
RESEND_API_KEY=

# --- OAuth integrations (NORA Flows Phase 2: Gmail / Google Calendar) ---
# 1. Create a project in the Google Cloud Console and configure the OAuth consent screen.
# 2. Create an OAuth Client ID (Web type) with the redirect URI pointing at the API:
#    dev:  http://localhost:8080/integrations/google/oauth/callback
#    prod: https://api.nora.systems/integrations/google/oauth/callback
# 3. Enable the APIs: Gmail API and Google Calendar API.
# Scopes requested: openid email, gmail.send, calendar.events.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/integrations/google/oauth/callback
# Signs the OAuth state (HMAC). Empty in dev = ephemeral secret per boot.
NORA_INTEGRATIONS_STATE_SECRET=
# Encrypts OAuth tokens at rest (AES-256-GCM): 32 bytes in base64.
# Generate with: openssl rand -base64 32 . Empty in dev = unencrypted tokens (WARN in the log).
NORA_INTEGRATIONS_ENC_KEY=

# --- OAuth integrations (NORA Flows Phase 2: Slack) ---
# 1. Create an app at https://api.slack.com/apps (From scratch) in your workspace.
# 2. Under "OAuth & Permissions" > Bot Token Scopes, add: chat:write and channels:read.
# 3. Under "OAuth & Permissions" > Redirect URLs, register the API callback:
#    dev:  http://localhost:8080/integrations/slack/oauth/callback
#    prod: https://api.nora.systems/integrations/slack/oauth/callback
# 4. Client ID and Client Secret are under "Basic Information" > App Credentials.
# The bot token (xoxb-...) does not expire; to post in a channel, invite the bot: /invite @NORA.
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URI=http://localhost:8080/integrations/slack/oauth/callback

# --- OAuth integrations (wave 1: GitHub, Notion, Todoist, Linear) ---
# All standard OAuth2 code-flow, with no refresh token in practice. Redirect URI to register
# with each provider: <api>/integrations/<provider>/oauth/callback (dev: localhost:8080).
# GitHub: OAuth App at https://github.com/settings/developers (repo scope).
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8080/integrations/github/oauth/callback
# Notion: public integration at https://www.notion.so/my-integrations (insert-content
# capabilities). The parent page used in the flows must be shared with the integration.
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=http://localhost:8080/integrations/notion/oauth/callback
# Todoist: app at https://developer.todoist.com/appconsole.html (data:read_write scope).
TODOIST_OAUTH_CLIENT_ID=
TODOIST_OAUTH_CLIENT_SECRET=
TODOIST_OAUTH_REDIRECT_URI=http://localhost:8080/integrations/todoist/oauth/callback
# Linear: OAuth app at https://linear.app/settings/api/applications (write scope).
LINEAR_OAUTH_CLIENT_ID=
LINEAR_OAUTH_CLIENT_SECRET=
LINEAR_OAUTH_REDIRECT_URI=http://localhost:8080/integrations/linear/oauth/callback

# --- Wave 2 integrations (Microsoft, Telegram, Trello) ---
# Microsoft (Outlook + Calendar): app at https://entra.microsoft.com (App registrations),
# Web platform, redirect <api>/integrations/microsoft/oauth/callback. OAuth2 WITH refresh
# (offline_access) — delegated scopes: openid email offline_access Mail.Send Calendars.ReadWrite.
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
MS_OAUTH_REDIRECT_URI=http://localhost:8080/integrations/microsoft/oauth/callback
# Telegram: token of the app's single BOT (created with @BotFather). NO OAuth — each tenant
# pairs by opening t.me/<bot>?start=<code> and the backend saves the chat_id as a connection.
NORA_TELEGRAM_BOT_TOKEN=
# Trello: our app's API key (https://trello.com/power-ups/admin). NO server-side OAuth —
# the hub opens Trello's authorize page and the user pastes the generated token.
TRELLO_API_KEY=

# --- NLP Worker ---
NLP_WORKER_BASE_URL=http://localhost:8001

# --- LGPD retention (ADR 0029) ---
# Age in days after which RetentionSweeper purges a meeting and everything that
# cascades from it (transcript with raw_text, participants, tags, analyses).
# The sentinel is at the BOTTOM of the range:
#
#   0 or negative  -> retention OFF. Nothing is ever purged. This is the default.
#   N >= 1         -> retention ON. Meetings older than N days are purged.
#
# No value means "delete immediately": lowering this towards zero turns the purge
# OFF, it does not accelerate it. The delete is physical and irreversible.
# The window is GLOBAL — one number for every tenant. There is no per-tenant
# setting and no link to tenant status.
# The API logs `Retention ON`/`Retention OFF` at boot.
NORA_PRIVACY_RETENTION_DAYS=0
# Sweep cron, Spring format with 6 fields (sec min hour day month dow).
NORA_PRIVACY_RETENTION_CRON=0 30 3 * * *

# --- Logging ---
LOG_LEVEL=INFO
