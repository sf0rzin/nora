    {
      "datasource": {
        "type": "prometheus",
        "uid": "nora-prometheus"
      },
      "description": "Total requests per second seen by Caddy. This is the edge aggregate, NOT per service: Caddy's labels are server/handler/code/method and `server` is the listener name (srv0), not the Host. Since web/api/admin/grafana share the same listener behind cloudflared, there is no way to split by domain here.\n\nDEPENDS on `servers { metrics }` in the Caddyfile's global block. Since Caddy 2.7 the caddy_http_* metrics are opt-in; without that line the panel stays empty with no error at all.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "reqps"
        },
        "overrides": []
