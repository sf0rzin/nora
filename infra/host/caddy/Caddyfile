# =============================================================================
# NORA — Caddy: Host-based routing + rolling-update retry buffer.
# =============================================================================
#
# Position in the topology:
#
#   Internet -> Cloudflare edge (TLS) -> cloudflared (tunnel) -> CADDY -> apps
#
# ## Why there is NO TLS here
#
# The visitor's TLS terminates at the Cloudflare edge (Universal SSL). cloudflared
# opens an OUTBOUND connection to Cloudflare and delivers the
# request as plain HTTP to `caddy:80`, all within Docker's bridges
# (`internal` is `internal: true`). The stack publishes no inbound port on this host — every
# compose binding is on 127.0.0.1, and there is no hypervisor: it is one physical machine
# (ADR 0036). sshd on 22 is the host's own and is a separate matter. That is why
# `auto_https off`: without it Caddy would see the host names
# below, try to issue a certificate via ACME, and fail in a loop (there is no
# :443 reachable from outside), on top of redirecting 80 -> 443 and taking down the tunnel.
#
# ## Why this file is the heart of the rolling update
#
# `docker compose up -d` TAKES DOWN the old container BEFORE bringing up the new one —
# there is no readiness gate like Container Apps' `activeRevisionsMode: Single`.
# The API takes ~45s to come up (JVM + Flyway; that is the compose healthcheck's
# `start_period: 45s`). In that window the name `api` either does not resolve
# (NXDOMAIN, the container is gone) or resolves to an IP that refuses the connection.
#
# Without this configuration, every one of these requests becomes an immediate 502. With
# `lb_try_duration`, Caddy HOLDS the request and keeps retrying the dial every
# `lb_try_interval` until the upstream accepts it. The user sees a slow
# request instead of an error — exactly the trade-off you want during a deploy.
#
# The retry covers DIAL failure (connection refused AND DNS failure), which is
# exactly what happens when the container gets recreated. There is no active
# health check on purpose: with a single upstream, a wrong `health_uri` would mark the
# backend as down forever and turn the buffer into a wall.
#
# ## Validate before deploying
#
#   docker run --rm -v "$PWD/caddy/Caddyfile:/etc/caddy/Caddyfile:ro" \
#     caddy:2.8-alpine caddy validate --config /etc/caddy/Caddyfile
#
# Reload without downtime (Caddy is the one thing that cannot blink):
#   docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile
# =============================================================================

{
	# ---- Admin API + /metrics (:2019) -------------------------------------
	# Bind on 0.0.0.0, NOT on loopback. Two reasons, and the second is mandatory:
	#
	#   1. The compose healthcheck (docker-compose.yml:101) runs FROM INSIDE
	#      this container and would work with loopback.
	#   2. The `caddy` job in ../observability/prometheus.yml scrapes
	#      `caddy:2019` FROM OUTSIDE, from the Prometheus container. With
	#      Caddy's default (`admin localhost:2019`) that scrape gets connection
	#      refused and Grafana's edge panel shows "No data" with no error.
	#
	# The trade-off is real: the admin API reconfigures the entire proxy at runtime,
	# and 0.0.0.0 exposes it to every container on the `edge` and `internal` networks.
	# Acceptable because neither has a route to the internet (`internal` is
	# `internal: true`; on `edge` only cloudflared exists) and no
	# :2019 port is published on the host. If a third-party container ever joins
	# `internal`, this becomes `admin localhost:2019` + a dedicated exporter.
	admin 0.0.0.0:2019

	# WATCH OUT for the compose healthcheck:
	#     wget --quiet --tries=1 --spider http://localhost:2019/config/
	# busybox's `--spider` issues HEAD, and the Caddy admin API's /config/ handler
	# only handles GET/POST/PUT/PATCH/DELETE — HEAD falls through to the default and
	# returns 405, which makes wget exit != 0 and the container NEVER become healthy
	# (and cloudflared, which has `condition: service_healthy`, never comes up).
	# Swap it for a real GET, or point it at the :80 block's /healthz
	# further down (that one is served by `respond`, which answers HEAD without complaint):
	#     test: ["CMD", "wget", "-qO-", "http://localhost:2019/config/"]
	#     test: ["CMD", "wget", "--spider", "-q", "http://localhost/healthz"]

	# ---- No TLS at the origin ----------------------------------------------
	# Turns off ACME and the automatic 80 -> 443 redirect. See the header comment.
	auto_https off

	# ---- JSON logs to stdout -----------------------------------------------
	# Alloy reads the Docker socket and sends every container's stdout to
	# Loki. Logging to a file here would be invisible to the pipeline.
	# `level INFO`: DEBUG in Caddy is extremely verbose and pollutes Loki.
	log {
		output stdout
		format json
		level INFO
	}

	# ---- Shutdown ------------------------------------------------------------
	# SSE connections stay open indefinitely. Without a limit, Caddy
	# would wait for them on shutdown and `docker compose stop` would only finish on
	# SIGKILL, after Docker's entire timeout.
	grace_period 15s

	servers {
		# The real client sits behind cloudflared, which is on a private
		# bridge. Without this, Caddy would treat cloudflared's IP as the client
		# and ignore X-Forwarded-For. (The visitor's public IP also
		# arrives in the `Cf-Connecting-Ip` header; to use it as client_ip in the
		# logs, add `client_ip_headers Cf-Connecting-Ip` here.)
		trusted_proxies static private_ranges

		# Since Caddy 2.7 per-handler metrics are OPT-IN (cardinality cost).
		# WITHOUT this line, :2019/metrics responds 200 but only
		# with Go runtime metrics — no `caddy_http_request_*`. The
		# Prometheus scrape "works" and the dashboard stays empty: it is the
		# silent failure that ../observability/prometheus.yml warns about in the `caddy` job.
		#
		# Known limitation: the label is `server` (srv0, srv1...), not the Host.
		# Since web/api/admin/grafana all come in through the same :80 listener,
		# this gives the edge AGGREGATE, not per-service RED.
		metrics
	}
}

# NOTE on compression: there is NO `encode` in this file, on purpose.
# Cloudflare already compresses at the edge, and compressing a `text/event-stream`
# along the way is the easiest way to reintroduce buffering into the chat.

# =============================================================================
# APEX + WWW -> web:3000
# =============================================================================
# Next.js (SSR + BFF). The BFF's `/api/chat` streams token by token, so
# this route also needs `flush_interval -1`.
http://{$NORA_PUBLIC_DOMAIN:nora.systems}, http://www.{$NORA_PUBLIC_DOMAIN:nora.systems} {
	log

	reverse_proxy web:3000 {
		# --- rolling-update buffer ---
		lb_try_duration 60s
		lb_try_interval 500ms

		# --- streaming ---
		# -1 = forwards every byte immediately, no intermediate buffer.
		# Without this the chat only "appears" once the entire response finishes.
		flush_interval -1

		# TLS terminated at Cloudflare; the app needs to know the public
		# origin is https to build absolute URLs and Secure cookies.
		header_up X-Forwarded-Proto https

		transport http {
			# Short dial so the retry cycle spins fast during boot.
			dial_timeout 2s
			# Time until the FIRST byte of the response header. Does not limit the
			# stream's duration once it starts.
			response_header_timeout 120s
		}
	}
}

# =============================================================================
# api.<domain> -> api:8080
# =============================================================================
# Spring Boot. The route most sensitive to the rolling update: it is the one that takes ~45s to
# come up (JVM + Flyway) and the one that serves the chat's SSE.
http://api.{$NORA_PUBLIC_DOMAIN:nora.systems} {
	log

	reverse_proxy api:8080 {
		# --- rolling-update buffer ---
		# 60s > the API healthcheck's 45s `start_period` in the compose.
		# Deliberate margin: a Flyway run with a new migration takes longer.
		lb_try_duration 60s
		lb_try_interval 500ms

		# --- streaming (chat SSE) ---
		flush_interval -1

		header_up X-Forwarded-Proto https

		transport http {
			dial_timeout 2s
			response_header_timeout 120s
		}
	}
}

# =============================================================================
# admin.<domain> -> admin:3002   (profile `platform`)
# =============================================================================
# Operator console. Authentication happens at the EDGE, in Cloudflare's Access
# Application; cloudflared injects the `Cf-Access-Jwt-Assertion` header and
# admin validates it against the JWKS (CF_ACCESS_TEAM_DOMAIN + CF_ACCESS_AUD).
# Caddy passes incoming headers through unfiltered — do not remove that header.
#
# With the `platform` profile OFF this block still exists and the
# `admin` upstream does not resolve: the request will retry for 60s and return
# 502. That is the correct behavior (visible failure), do not mistake it for a bug.
http://admin.{$NORA_PUBLIC_DOMAIN:nora.systems} {
	log

	reverse_proxy admin:3002 {
		lb_try_duration 60s
		lb_try_interval 500ms

		# Next.js: no critical streaming, but keeping the behavior uniform
		# avoids surprises on a new route that uses SSE.
		flush_interval -1

		header_up X-Forwarded-Proto https

		transport http {
			dial_timeout 2s
			response_header_timeout 120s
		}
	}
}

# =============================================================================
# grafana.<domain> -> grafana:3000
# =============================================================================
# GF_SERVER_ROOT_URL is already set to https://grafana.<domain> in the compose,
# so Grafana builds its links correctly. The WebSocket upgrade (Live /
# panel streaming) is handled natively by reverse_proxy.
http://grafana.{$NORA_PUBLIC_DOMAIN:nora.systems} {
	log

	reverse_proxy grafana:3000 {
		lb_try_duration 60s
		lb_try_interval 500ms
		flush_interval -1

		header_up X-Forwarded-Proto https

		transport http {
			dial_timeout 2s
			response_header_timeout 120s
		}
	}
}

# =============================================================================
# CATCH-ALL — any other Host on :80
# =============================================================================
# Catches an unknown Host, direct IP access on the bridge, and internal scanners.
# Answers a bare 404 instead of leaking which service exists behind it.
# `:80` (no host) is the least specific address possible: the host-matched blocks
# above always win in routing; this one only gets what is left over.
:80 {
	# Operational convenience: `docker compose exec <svc> wget -qO- http://caddy/healthz`
	# confirms that Caddy is routing, without depending on the admin API.
	handle /healthz {
		respond "ok" 200
	}

	handle {
		respond "not found" 404
	}
}
