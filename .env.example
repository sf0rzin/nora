# NORA — variáveis comuns de desenvolvimento. Copie para .env.local e ajuste.
# Nunca commite .env.local.

# --- Postgres (compartilhado pelos serviços via docker-compose) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nora
POSTGRES_USER=nora
POSTGRES_PASSWORD=nora_dev

# --- Backend (services/api) ---
API_PORT=8080
API_JWT_SECRET=change-me-please-min-32-chars-long-aaaa
API_JWT_EXPIRES_SECONDS=3600
API_NLP_WORKER_URL=http://localhost:8001

# --- NLP Worker (services/nlp-worker) ---
WORKER_PORT=8001
WORKER_LLM_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_CHAT=gpt-4o
AZURE_OPENAI_DEPLOYMENT_EMBEDDING=text-embedding-3-large
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- Web (apps/web) ---
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- Observability (opcional no MVP) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
