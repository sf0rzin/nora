# NORA (root) — variables used by the local infra (docker compose).
# Copy to `/.env.local` and adjust. Never commit `.env.local`.

# --- Postgres (infra/docker/docker-compose.yml) ---
POSTGRES_DB=nora
POSTGRES_USER=nora
POSTGRES_PASSWORD=nora_dev

# Note: API/worker/web/desktop variables live in their respective files:
# - services/api/.env.example
# - services/nlp-worker/.env.example
# - apps/web/.env.example
# - apps/desktop/.env.example
