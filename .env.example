# NORA — variáveis comuns de desenvolvimento. Copie para .env.local e ajuste.
# Nunca commite .env.local.

# --- Postgres (compartilhado pelos serviços via docker-compose) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nora
POSTGRES_USER=nora
POSTGRES_PASSWORD=nora_dev

# --- Backend (services/api) ---
API_PORT=8080
API_JWT_SECRET=change-me-please-min-32-chars-long-aaaa
API_JWT_EXPIRES_SECONDS=3600
API_NLP_WORKER_URL=http://localhost:8001

# --- NLP Worker (services/nlp-worker) ---
WORKER_PORT=8001
# LLM provider agnostico - ver docs/adr/0004-llm-provider-strategy.md
# Default no MVP: OpenAI direto com gpt-4o-mini.
# Para Azure OpenAI: setar LLM_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>
#                    e LLM_MODEL=<deployment-name>
# Para Groq:        LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile
# Para OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1
USE_LLM_STUB=true
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_EMBEDDING_MODEL=text-embedding-3-small

# --- Web (apps/web) ---
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- Observability (opcional no MVP) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
