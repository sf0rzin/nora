# --- OS / Editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml

# --- IDE / Eclipse ---
.settings/
.project
.classpath
.factorypath

# --- Environments ---
.env
.env.local
.env.*.local
# .env.ci: placeholders generated by ci.yml's `infra` job so it can run
# `docker compose config` (the compose uses ${VAR:?} and fails without the vars). It is
# ephemeral on the runner, but reproducing the step locally leaves an un-ignored .env.* in
# git status — and a trackable .env.* is how a secret gets committed by accident.
.env.ci
!.env.example
# The SOPS-ENCRYPTED file is versioned on purpose (the age key lives only on the host,
# at /etc/nora/age.key). The `!` guards against any future .env* rule.
!infra/host/secrets.env.sops

# --- Logs / temporary ---
*.log
logs/
tmp/
.cache/
.logs/
.run/

# --- Node / Web ---
node_modules/
.next/
out/
coverage/
.pnpm-store/

# Playwright output. `playwright-report/` and `test-results/` are regenerated on every run;
# `.last-run.json` records which tests failed last time and is per-machine state.
playwright-report/
test-results/
blob-report/
.playwright/
*/.last-run.json

