{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nora:schemas:meeting-analysis:v1",
  "title": "MeetingAnalysisV1",
  "description": "Resultado estruturado da análise de uma reunião pelo LLM, validado pelo NLP Worker antes de ser persistido pelo backend.",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "decisions", "actionItems", "risks", "opportunities", "sentimentOverall", "topics"],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 30,
      "maxLength": 2000,
      "description": "Resumo executivo em texto puro, 1 a 3 parágrafos, no idioma da transcrição."
    },
    "decisions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "confidence"],
        "properties": {
          "text": { "type": "string", "minLength": 5, "maxLength": 500 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "actionItems": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "priority", "sourceQuote"],
        "properties": {
          "title": { "type": "string", "minLength": 5, "maxLength": 240 },
          "assignee": { "type": ["string", "null"], "maxLength": 120 },
          "dueDate": { "type": ["string", "null"], "format": "date" },
          "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
          "sourceQuote": { "type": "string", "minLength": 5, "maxLength": 500 }
        }
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "severity", "category", "sourceQuote"],
        "properties": {
          "text": { "type": "string", "minLength": 5, "maxLength": 500 },
          "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
          "category": {
            "type": "string",
            "enum": ["COMPETITION", "PRICE", "CHURN", "TIMELINE", "TECHNICAL", "COMPLIANCE", "OTHER"]
          },
          "sourceQuote": { "type": "string", "minLength": 5, "maxLength": 500 }
        }
      }
    },
    "opportunities": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "estimatedValue", "category", "sourceQuote"],
        "properties": {
          "text": { "type": "string", "minLength": 5, "maxLength": 500 },
          "estimatedValue": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
          "category": {
            "type": "string",
            "enum": ["UPSELL", "CROSS_SELL", "REFERRAL", "EXPANSION", "OTHER"]
          },
          "sourceQuote": { "type": "string", "minLength": 5, "maxLength": 500 }
        }
      }
    },
    "sentimentOverall": {
      "type": "string",
      "enum": ["POSITIVE", "NEUTRAL", "NEGATIVE", "MIXED"]
    },
    "topics": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "minLength": 2, "maxLength": 60 }
    },
    "participants": {
      "type": "array",
      "maxItems": 30,
      "description": "Participantes mencionados na transcrição (US13). Default vazio.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "mentionCount"],
        "properties": {
          "name": { "type": "string", "minLength": 2, "maxLength": 120 },
          "role": { "type": ["string", "null"], "maxLength": 120 },
          "mentionCount": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "baselineTerms": {
      "type": "array",
      "maxItems": 50,
      "description": "Termos TF-IDF extraídos pelo nlp-baseline ANTES do LLM (interpretável, ADR 0010). Preenchido pelo worker pós-redação PII; não é gerado pelo LLM. Default vazio.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "score"],
        "properties": {
          "term": { "type": "string", "minLength": 1, "maxLength": 120 },
          "score": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "productivity": {
      "type": ["object", "null"],
      "description": "Avaliação de produtividade da reunião. Presente apenas quando o usuário ativou o recurso e declarou objetivo/outcomes esperados.",
      "additionalProperties": false,
      "required": ["score", "band", "coverage", "rationale"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "band": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
        "coverage": {
          "type": "array",
          "description": "Para cada outcome esperado declarado, status de cobertura na reunião.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["expectedOutcome", "status"],
            "properties": {
              "expectedOutcome": { "type": "string", "minLength": 3, "maxLength": 240 },
              "status": { "type": "string", "enum": ["ADDRESSED", "PARTIAL", "MISSED"] },
              "evidence": { "type": ["string", "null"], "maxLength": 500 }
            }
          }
        },
        "offTopicRatio": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "decisionDensity": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "rationale": { "type": "string", "minLength": 10, "maxLength": 1000 }
      }
    },
    "customerConfidence": {
      "type": ["object", "null"],
      "description": "RESERVADO / AINDA NÃO EMITIDO PELO WORKER (2026-05-21). Bloco desenhado em ADR 0006; persistência mínima aceita em ADR 0015 mas NÃO implementada (worker Pydantic MeetingAnalysisV1 não inclui este campo; nenhuma migration/endpoint existe). Mantido aqui como contrato-alvo. Quando implementado: confiança do cliente/lead na nossa empresa, derivada de sentimento, sinais de compra e objeções. Enterprise-only; null para reuniões internas. Complementa (não substitui) o Account Health Score temporal.",
      "additionalProperties": false,
      "required": ["score", "band", "rationale"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "band": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
        "trend": {
          "type": ["string", "null"],
          "enum": ["IMPROVING", "STABLE", "DECLINING", null],
          "description": "Comparacao com a ultima reuniao da mesma conta; null se for a primeira reuniao da conta."
        },
        "buyingSignals": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "quote"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["BUDGET_DISCUSSED", "TIMELINE_DISCUSSED", "STAKEHOLDER_INVOLVED", "NEXT_STEP_REQUESTED", "REFERENCE_REQUESTED", "PROPOSAL_REQUESTED", "OTHER"]
              },
              "quote": { "type": "string", "minLength": 5, "maxLength": 500 },
              "weight": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
            }
          }
        },
        "objections": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "quote", "severity"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["PRICE", "TIMELINE", "AUTHORITY", "NEED", "COMPETITOR_MENTION", "TRUST", "FEATURE_GAP", "OTHER"]
              },
              "quote": { "type": "string", "minLength": 5, "maxLength": 500 },
              "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
              "competitor": { "type": ["string", "null"], "maxLength": 120 }
            }
          }
        },
        "rationale": { "type": "string", "minLength": 10, "maxLength": 1000 }
      }
    }
  }
}
