{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nora:schemas:tenant-context-embedding:v1",
  "title": "TenantContextEmbeddingV1",
  "description": "Chunk indexável do contexto do tenant para uso em RAG (Azure AI Search).",
  "type": "object",
  "additionalProperties": false,
  "required": ["chunkId", "tenantId", "type", "content"],
  "properties": {
    "chunkId": { "type": "string", "format": "uuid" },
    "tenantId": { "type": "string", "format": "uuid" },
    "type": {
      "type": "string",
      "enum": ["COMPANY_OVERVIEW", "PRODUCT", "PLAYBOOK", "GLOSSARY", "COMPETITOR", "ICP"]
    },
    "title": { "type": "string", "maxLength": 240 },
    "content": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "embedding": {
      "type": "array",
      "items": { "type": "number" },
      "description": "Vetor de embedding. MVP usa text-embedding-3-small (1536 dimensões) conforme ADR 0004 §5; modelo final da fatia RAG ainda TBD (US15 deferido)."
    },
    "version": { "type": "integer", "minimum": 1 },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
