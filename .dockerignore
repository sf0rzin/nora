# Repo-root .dockerignore — used when the build context is the repo root (e.g. worker)
.git
.github
.claude
.idea
.vscode
.settings

# Apps that are not part of the worker build
apps/desktop
apps/web

# Other services
services/api

# Everything in the worker that is NOT src or pyproject
services/nlp-worker/.venv
services/nlp-worker/__pycache__
services/nlp-worker/.pytest_cache
services/nlp-worker/.ruff_cache
services/nlp-worker/tests

# Misc
docs
infra
notebooks
data
**/*.log
**/.DS_Store
**/node_modules
**/target
**/dist
**/build
**/.next
