# Configuração local do web (Next.js). Copie para .env.local.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_APP_ENV=local
# Quando true, paginas de reuniao usam fixtures em src/fixtures/ (sem backend).
# Default false: o app vai contra a API real (NEXT_PUBLIC_API_BASE_URL).
NEXT_PUBLIC_USE_MOCKS=false
