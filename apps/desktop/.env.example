# Configuração local do NORA Desktop (Tauri + Vite).
# Copie para `.env.local` e ajuste. Nunca commite `.env` com secrets.

# --- API backend ---
# URL do backend NORA usada em dev pelo script `npm run dev` (Vite). Em prod o
# binário Tauri usa o valor de `plugins.nora.apiBaseUrl` em `tauri.conf.json`.
NORA_API_BASE_URL=http://localhost:8080

# --- Sidecar STT (opcional, normalmente NAO necessario) ---
# Caminho absoluto para o binário do sidecar de speech-to-text.
# Se não definido, o Tauri procura automaticamente em:
#   - src-tauri/binaries/ (produção)
#   - target/debug/ ou target/release/ (dev, fallback)
# NORA_SIDECAR_PATH=/caminho/absoluto/para/nora-stt-sidecar

# --- Linux Wayland workaround (opcional) ---
# Forca uso de X11 em vez de Wayland — webkit2gtk tem bugs em Wayland puro.
# Setado automaticamente pelo script `npm run tauri:linux`.
# GDK_BACKEND=x11
# WEBKIT_DISABLE_DMABUF_RENDERER=1
