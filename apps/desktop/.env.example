# Local configuration for NORA Desktop (Tauri + Vite).
# Copy to `.env.local` and adjust. Never commit `.env` with secrets.

# --- API backend ---
# NORA backend URL used in dev by the `npm run dev` script (Vite). In prod the
# Tauri binary uses the value of `plugins.nora.apiBaseUrl` in `tauri.conf.json`.
NORA_API_BASE_URL=http://localhost:8080

# ============================================================================
# STT (speech-to-text)
# ============================================================================
# Transcription backend. Default: `local`.
#   local  — whisper.cpp embedded in Rust, runs 100% on the user's machine.
#            Uses no network, does not call /speech/token, spawns no subprocess.
#
# WARNING: an app opened from Explorer/Finder does NOT inherit env from the shell.
# In production the effective value comes from `plugins.nora.sttBackend` in
# tauri.conf.json or from the env injected at build-time by build.rs. This env here
# only counts when the app is launched from a terminal (dev).
# NORA_STT_BACKEND=local

# --- Whisper model (only counts with NORA_STT_BACKEND=local) ---
# GGML model size. Default: `small`.
#   tiny   —  ~78 MB · smoke test/CI only, bad quality in pt-BR
#   base   — ~148 MB · acceptable in pt-BR, runs easily on a weak CPU
#   small  — ~488 MB · DEFAULT, best quality/latency trade in pt-BR
#   medium — ~1.5 GB · best quality, needs a strong CPU or a GPU
# Downloaded on demand on first use into <app_data_dir>/models/, with
# sha256 verification. Progress goes to the Tauri event `stt-model-progress`.
# NORA_WHISPER_MODEL=small

# Internal mirror of the GGMLs (corporate network that blocks HuggingFace).
# The checksum is still verified against the expected value.
# NORA_WHISPER_MODEL_BASE_URL=https://mirror.interno/whisper.cpp

# Your own model (q5_1 quantized, pt-BR fine-tune, offline copy).
# SKIPS the download AND the checksum verification — whoever points it takes the risk.
# NORA_WHISPER_MODEL_PATH=/absolute/path/ggml-small-q5_1.bin

# Inference threads PER TRACK. Default: half the cores, cap 4.
# There are two tracks decoding at the same time (mic + system); raising it too
# much causes oversubscribe and MAKES latency WORSE.
# NORA_WHISPER_THREADS=4

# Reduces the encoder's audio_ctx (0 = full/1500). Cuts latency at the cost of
# quality. The good value depends on the hardware — there is no safe default.
# NORA_WHISPER_AUDIO_CTX=768

# Forces CPU even on a binary compiled with Metal/CUDA/Vulkan.
# NORA_WHISPER_FORCE_CPU=1


# --- Linux Wayland workaround (optional) ---
# Forces the use of X11 instead of Wayland — webkit2gtk has bugs on pure Wayland.
# Set automatically by the `npm run tauri:linux` script.
# GDK_BACKEND=x11
# WEBKIT_DISABLE_DMABUF_RENDERER=1
