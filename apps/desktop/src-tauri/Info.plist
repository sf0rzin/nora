<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Microfone: já necessário para captura de voz do usuário (PR #8). -->
    <key>NSMicrophoneUsageDescription</key>
    <string>NORA precisa de acesso ao microfone para gravar e transcrever sua voz durante reuniões.</string>

    <!-- Gravação de tela: requerida pelo ScreenCaptureKit mesmo quando se captura
         apenas áudio do sistema (sem janelas). Necessário a partir do macOS 13.
         Hoje a captura usa o driver virtual BlackHole, mas mantemos a entitlement
         declarada para a futura migração ao caminho ScreenCaptureKit (Issue #15). -->
    <key>NSScreenCaptureUsageDescription</key>
    <string>NORA precisa permissão de gravação de tela para capturar o áudio do sistema (vozes de outros participantes em chamadas) sem precisar de driver virtual.</string>
</dict>
</plist>
