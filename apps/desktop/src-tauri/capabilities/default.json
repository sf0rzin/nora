{
  "identifier": "default",
  "description": "Main-window capability: full core + sidecar execution + open external URLs",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "binaries/nora-stt-sidecar", "sidecar": true, "args": true }
      ]
    }
  ]
}
