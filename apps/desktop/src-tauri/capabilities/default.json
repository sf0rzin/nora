{
  "identifier": "default",
  "description": "Default capability for NORA Desktop",
  "windows": ["main", "overlay"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "binaries/nora-stt-sidecar", "sidecar": true, "args": true }
      ]
    }
  ]
}
