{
  "$schema": "gen/schemas/desktop-schema.json",
  "productName": "Nora Desktop",
  "version": "0.2.5",
  "identifier": "com.nora.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nora Desktop",
        "url": "https://nora.systems/dashboard",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "backgroundColor": "#FDFDFC"
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "Nora Live",
        "width": 700,
        "height": 600,
        "minWidth": 520,
        "minHeight": 280,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": true,
        "skipTaskbar": true
      },
      {
        "label": "dock",
        "url": "dock.html",
        "title": "Nora Dock",
        "width": 460,
        "height": 56,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": true,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "plugins": {
    "nora": {
      "apiBaseUrl": "http://localhost:8080"
    },
    "updater": {
      "endpoints": [
        "https://github.com/sys0xFF/nora/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzMTRGRjNGNkEyNjgyNjYKUldSbWdpWnFQLzhVNDVQUmVydUQ3aWYzNFN6cER4eDJhOXAzd3E5MUNYMDdXNEk5cE8yMjh1UzMK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/nora-stt-sidecar"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
