{
  "$schema": "gen/schemas/desktop-schema.json",
  "productName": "NORA Desktop",
  "version": "0.2.2",
  "identifier": "com.nora.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NORA Desktop",
        "url": "https://nora.systems/dashboard",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "backgroundColor": "#FDFDFC"
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "NORA Live",
        "width": 700,
        "height": 600,
        "minWidth": 520,
        "minHeight": 280,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": true,
        "skipTaskbar": true
      },
      {
        "label": "dock",
        "url": "dock.html",
        "title": "NORA Dock",
        "width": 320,
        "height": 60,
        "minWidth": 320,
        "minHeight": 60,
        "maxWidth": 320,
        "maxHeight": 60,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": false,
        "skipTaskbar": true,
        "focus": false
      },
      {
        "label": "recorder",
        "title": "NORA — Gravação",
        "url": "recorder.html",
        "width": 940,
        "height": 700,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "decorations": true,
        "visible": false,
        "backgroundColor": "#FDFDFC"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "nora": {
      "apiBaseUrl": "http://localhost:8080"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/nora-stt-sidecar"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
