{
  "$schema": "https://raw.githubusercontent.com/nora/desktop/main/src-tauri/gen/schemas/desktop-schema.json",
  "productName": "NORA Desktop",
  "version": "0.1.0",
  "identifier": "com.nora.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NORA Desktop",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#FDFDFC"
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "NORA Live",
        "width": 720,
        "height": 360,
        "minWidth": 520,
        "minHeight": 280,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": true,
        "skipTaskbar": true
      },
      {
        "label": "dock",
        "url": "dock.html",
        "title": "NORA Dock",
        "width": 320,
        "height": 60,
        "minWidth": 320,
        "minHeight": 60,
        "maxWidth": 320,
        "maxHeight": 60,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": false,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' http://localhost:* ws://localhost:*; connect-src 'self' http://localhost:* http://127.0.0.1:*; script-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "plugins": {
    "nora": {
      "apiBaseUrl": "http://localhost:8080"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/nora-stt-sidecar"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
